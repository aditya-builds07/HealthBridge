<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient">

    <!-- Scrollable Dashboard Content -->
    <ScrollView
        android:id="@+id/dashboardScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <!-- Main Dashboard Content Container -->
        <LinearLayout
            android:id="@+id/dashboardContentLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="24dp"
            android:paddingBottom="24dp">

            <!-- ── Top Header Bar ──────────────────────────────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="16dp">

                    <TextView
                        android:id="@+id/tvAppName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/app_name"
                        android:textColor="@color/hb_text_on_dark"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvTagline"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/tagline"
                        android:textColor="@color/hb_text_on_dark"
                        android:alpha="0.8"
                        android:textSize="12sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/imgAvatar"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_glass_card"
                    android:padding="10dp"
                    android:src="@drawable/ic_patient_avatar"
                    android:tint="@color/hb_text_on_dark"
                    android:contentDescription="@string/cd_patient_avatar" />
            </LinearLayout>

            <!-- ── Patient Greeting ────────────────────────────────────── -->
            <TextView
                android:id="@+id/tvGreeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/greeting_morning"
                android:textColor="@color/hb_text_on_dark"
                android:alpha="0.9"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvPatientName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/hb_text_on_dark"
                android:textSize="28sp"
                android:textStyle="bold"
                android:ellipsize="end"
                android:maxLines="1" />

            <!-- ── Profile Incomplete Action Banner (Appears when skipped or incomplete) ── -->
            <LinearLayout
                android:id="@+id/cardCompleteProfileBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_glass_card"
                android:padding="12dp"
                android:visibility="gone"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✚"
                    android:textColor="@color/hb_teal_primary"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/banner_complete_profile"
                    android:textColor="@color/hb_teal_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_chevron_right"
                    android:tint="@color/hb_teal_primary"
                    android:importantForAccessibility="no" />
            </LinearLayout>

            <!-- ── Emergency Red-Alert Card ────────────────────────────── -->
            <LinearLayout
                android:id="@+id/cardEmergency"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:background="@drawable/bg_emergency_card"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_emergency_alert"
                        android:tint="@color/hb_on_emergency"
                        android:contentDescription="@string/cd_emergency_alert" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/emergency_title"
                        android:textColor="@color/hb_on_emergency"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Row 1: Blood Group (shown large) -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/blood_group_label"
                    android:textColor="@color/hb_on_emergency"
                    android:alpha="0.85"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvBloodGroup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/not_provided"
                    android:textColor="@color/hb_on_emergency"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <!-- Row 2: Allergies -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/allergies_label"
                    android:textColor="@color/hb_on_emergency"
                    android:alpha="0.85"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvAllergies"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/not_provided"
                    android:textColor="@color/hb_on_emergency"
                    android:textSize="14sp"
                    android:ellipsize="end"
                    android:maxLines="2" />

                <!-- Row 3: Emergency Contact -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/emergency_contact_label"
                    android:textColor="@color/hb_on_emergency"
                    android:alpha="0.85"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvEmergencyContact"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/not_provided"
                    android:textColor="@color/hb_on_emergency"
                    android:textSize="14sp"
                    android:ellipsize="end"
                    android:maxLines="2" />
            </LinearLayout>

            <!-- ── Vitals Glass Strip ──────────────────────────────────── -->
            <LinearLayout
                android:id="@+id/cardVitals"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:background="@drawable/bg_glass_card"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/vitals_title"
                        android:textColor="@color/hb_text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <!-- BMI Badge (Pill with dynamic background color) -->
                    <TextView
                        android:id="@+id/tvBmiBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="32dp"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp"
                        android:text="@string/bmi_na"
                        android:textColor="@color/hb_text_on_dark"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:gravity="center" />
                </LinearLayout>

                <!-- Vitals 2x2 Grid -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="16dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginEnd="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/vitals_height"
                            android:textColor="@color/hb_text_secondary"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvHeight"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/not_provided"
                            android:textColor="@color/hb_text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/vitals_weight"
                            android:textColor="@color/hb_text_secondary"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvWeight"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/not_provided"
                            android:textColor="@color/hb_text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>


            </LinearLayout>

            <!-- ── Quick Actions Section ───────────────────────────────── -->
            <TextView
                android:id="@+id/tvQuickActionsTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/quick_actions_title"
                android:textColor="@color/hb_text_on_dark"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- Row 1: SOS & Hospitals -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">

                <!-- SOS Tile (Most prominent action with red accent circle) -->
                <LinearLayout
                    android:id="@+id/btnSos"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="96dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_glass_card"
                    android:foreground="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="12dp"
                    android:contentDescription="@string/btn_sos">

                    <ImageView
                        android:id="@+id/imgSosIcon"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_icon_circle"
                        android:backgroundTint="@color/hb_emergency_red"
                        android:padding="8dp"
                        android:src="@drawable/ic_sos"
                        android:tint="@color/hb_on_emergency"
                        android:importantForAccessibility="no" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/btn_sos"
                        android:textColor="@color/hb_emergency_red"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:gravity="center" />
                </LinearLayout>

                <!-- Nearby Hospitals Tile (Tinted Lab circle) -->
                <LinearLayout
                    android:id="@+id/btnHospitals"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="96dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_glass_card"
                    android:foreground="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="12dp"
                    android:contentDescription="@string/btn_hospitals">

                    <ImageView
                        android:id="@+id/imgHospitalsIcon"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_icon_circle"
                        android:backgroundTint="@color/hb_cat_lab_bg"
                        android:padding="8dp"
                        android:src="@drawable/ic_hospital"
                        android:tint="@color/hb_cat_lab_text"
                        android:importantForAccessibility="no" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/btn_hospitals"
                        android:textColor="@color/hb_text_primary"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:gravity="center" />
                </LinearLayout>
            </LinearLayout>

            <!-- Row 2: Doctor Summary & QR Code -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">

                <!-- Doctor Summary Tile (Tinted PDF circle) -->
                <LinearLayout
                    android:id="@+id/btnDoctorSummary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="96dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_glass_card"
                    android:foreground="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="12dp"
                    android:contentDescription="@string/btn_generate_pdf">

                    <ImageView
                        android:id="@+id/imgPdfIcon"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_icon_circle"
                        android:backgroundTint="@color/hb_cat_pdf_bg"
                        android:padding="8dp"
                        android:src="@drawable/ic_picture_as_pdf"
                        android:tint="@color/hb_cat_pdf_text"
                        android:importantForAccessibility="no" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/btn_generate_pdf"
                        android:textColor="@color/hb_text_primary"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:gravity="center" />
                </LinearLayout>

                <!-- QR Code Tile (Tinted X-Ray circle) -->
                <LinearLayout
                    android:id="@+id/btnQrCode"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="96dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_glass_card"
                    android:foreground="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="12dp"
                    android:contentDescription="@string/btn_share_qr">

                    <ImageView
                        android:id="@+id/imgQrIcon"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_icon_circle"
                        android:backgroundTint="@color/hb_cat_xray_bg"
                        android:padding="8dp"
                        android:src="@drawable/ic_qr_code"
                        android:tint="@color/hb_cat_xray_text"
                        android:importantForAccessibility="no" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/btn_share_qr"
                        android:textColor="@color/hb_text_primary"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:gravity="center" />
                </LinearLayout>
            </LinearLayout>

            <!-- ── Document Vault Entry Card (Tinted Prescription circle) ── -->
            <LinearLayout
                android:id="@+id/cardVault"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_glass_card"
                android:foreground="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp"
                android:contentDescription="@string/btn_vault">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_icon_circle"
                    android:backgroundTint="@color/hb_cat_prescription_bg"
                    android:padding="8dp"
                    android:src="@drawable/ic_vault"
                    android:tint="@color/hb_cat_prescription_text"
                    android:importantForAccessibility="no" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/btn_vault"
                        android:textColor="@color/hb_text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/vault_subtitle"
                        android:textColor="@color/hb_text_secondary"
                        android:textSize="12sp"
                        android:maxLines="1"
                        android:ellipsize="end" />
                </LinearLayout>

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_chevron_right"
                    android:tint="@color/hb_teal_primary"
                    android:importantForAccessibility="no" />
            </LinearLayout>

            <!-- ── Patient Records Actions (Add Medication & Add History) ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddMedication"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:text="@string/btn_add_medication"
                    android:textColor="@color/hb_teal_deep"
                    app:backgroundTint="@color/hb_glass_fill"
                    app:cornerRadius="14dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddHistory"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="@string/btn_add_history"
                    android:textColor="@color/hb_teal_deep"
                    app:backgroundTint="@color/hb_glass_fill"
                    app:cornerRadius="14dp" />
            </LinearLayout>

            <!-- ── Logout Action ── -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogout"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="24dp"
                android:text="@string/btn_logout"
                android:textColor="@color/hb_text_on_dark"
                app:cornerRadius="14dp" />

        </LinearLayout>
    </ScrollView>

    <!-- Always Centered Teal Loading Indicator on Root FrameLayout -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:indeterminate="true"
        android:indeterminateTint="@color/hb_teal_primary"
        android:visibility="gone" />

</FrameLayout>
