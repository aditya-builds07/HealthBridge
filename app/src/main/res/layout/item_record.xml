<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    android:background="@drawable/bg_glass_card"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="76dp"
    android:orientation="horizontal"
    android:padding="16dp">

    <!-- Left: 48dp rounded icon tile with file-type icon -->
    <FrameLayout
        android:id="@+id/ivIconTile"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/bg_icon_tile">

        <ImageView
            android:id="@+id/ivIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:contentDescription="Document type icon"
            android:src="@android:drawable/ic_menu_agenda"
            app:tint="@color/hb_teal_primary" />
    </FrameLayout>

    <!-- Middle: Title, Date, Category Tag -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:singleLine="true"
            android:textColor="@color/hb_text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="Blood Test Report" />

        <TextView
            android:id="@+id/tvDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/hb_text_secondary"
            android:textSize="12sp"
            tools:text="Mar 15, 2026" />

        <TextView
            android:id="@+id/tvCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_tag"
            android:paddingStart="8dp"
            android:paddingTop="2dp"
            android:paddingEnd="8dp"
            android:paddingBottom="2dp"
            android:textColor="@color/hb_cat_prescription_text"
            android:textSize="12sp"
            tools:text="Prescription" />
    </LinearLayout>

    <!-- Right: Chevron icon -->
    <ImageView
        android:id="@+id/ivChevron"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:contentDescription="Open details"
        android:src="@drawable/ic_chevron_right"
        android:tint="@color/hb_teal_primary" />

</LinearLayout>
