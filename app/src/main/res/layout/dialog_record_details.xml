<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_glass_card"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Top: Preview Image (Glide Target, 160dp height, centerCrop) -->
        <ImageView
            android:id="@+id/ivPreview"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:contentDescription="Document preview"
            android:scaleType="centerCrop"
            android:src="@android:drawable/ic_menu_agenda" />

        <!-- Document Detail Title -->
        <TextView
            android:id="@+id/tvDetailTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/hb_text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            tools:text="Blood Test Report" />

        <!-- Document Detail Category Tag -->
        <TextView
            android:id="@+id/tvDetailCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp"
            android:background="@color/hb_cat_lab_bg"
            android:paddingStart="8dp"
            android:paddingTop="2dp"
            android:paddingEnd="8dp"
            android:paddingBottom="2dp"
            android:textColor="@color/hb_cat_lab_text"
            android:textSize="12sp"
            tools:text="Lab Report" />

        <!-- Info Row 1: File Name -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="File name icon"
                android:src="@android:drawable/ic_menu_agenda"
                app:tint="@color/hb_text_secondary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="File Name"
                    android:textColor="@color/hb_text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvFileName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="middle"
                    android:singleLine="true"
                    android:textColor="@color/hb_text_primary"
                    android:textSize="14sp"
                    tools:text="blood_test_report_2026.pdf" />
            </LinearLayout>
        </LinearLayout>

        <!-- Info Row 2: File Type -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="File type icon"
                android:src="@android:drawable/ic_menu_info_details"
                app:tint="@color/hb_text_secondary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="File Type"
                    android:textColor="@color/hb_text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvFileType"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/hb_text_primary"
                    android:textSize="14sp"
                    tools:text="application/pdf" />
            </LinearLayout>
        </LinearLayout>

        <!-- Info Row 3: Category -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="Category icon"
                android:src="@android:drawable/ic_menu_manage"
                app:tint="@color/hb_text_secondary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Category"
                    android:textColor="@color/hb_text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvDetailCategoryValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/hb_text_primary"
                    android:textSize="14sp"
                    tools:text="Lab Report" />
            </LinearLayout>
        </LinearLayout>

        <!-- Info Row 4: Uploaded On -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="Uploaded on icon"
                android:src="@android:drawable/ic_menu_my_calendar"
                app:tint="@color/hb_text_secondary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Uploaded On"
                    android:textColor="@color/hb_text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvUploadedOn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/hb_text_primary"
                    android:textSize="14sp"
                    tools:text="Mar 15, 2026" />
            </LinearLayout>
        </LinearLayout>

        <!-- Primary Action Button: View (full-width, 16dp radius, 48dp min height) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:minHeight="48dp"
            android:text="View"
            android:textColor="@color/hb_text_on_dark"
            android:textSize="14sp"
            app:backgroundTint="@color/hb_teal_primary"
            app:cornerRadius="16dp" />

    </LinearLayout>

</ScrollView>
