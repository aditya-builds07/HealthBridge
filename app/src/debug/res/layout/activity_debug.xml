<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/hb_card_solid"
    android:padding="12dp">

    <!-- Header -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="HB Debug Console"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/hb_teal_deep" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Supabase &amp; Auth Diagnostics (Debug Only)"
        android:textSize="11sp"
        android:textColor="@color/hb_text_secondary"
        android:layout_marginBottom="8dp" />

    <!-- Credentials Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <EditText
            android:id="@+id/editDebugEmail"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1.2"
            android:hint="Email"
            android:text="rahul@healthbridge.com"
            android:inputType="textEmailAddress"
            android:textSize="12sp"
            android:paddingHorizontal="8dp"
            android:background="@drawable/bg_glass_card"
            android:textColor="@color/hb_text_primary"
            android:layout_marginEnd="6dp" />

        <EditText
            android:id="@+id/editDebugPassword"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="0.8"
            android:hint="Password"
            android:text="123456"
            android:inputType="textPassword"
            android:textSize="12sp"
            android:paddingHorizontal="8dp"
            android:background="@drawable/bg_glass_card"
            android:textColor="@color/hb_text_primary" />
    </LinearLayout>

    <!-- Buttons Row 1: 1. Config, 2. Internet, 3. Test Login -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="4dp">

        <Button
            android:id="@+id/btnConfig"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:text="Config"
            android:textSize="11sp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btnInternet"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:text="Internet"
            android:textSize="11sp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btnTestLogin"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1.2"
            android:text="Test Login"
            android:textSize="11sp"
            android:insetTop="0dp"
            android:insetBottom="0dp" />
    </LinearLayout>

    <!-- Buttons Row 2: 4. Test Profile, 5. Test Tables, 6. Test Storage -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="4dp">

        <Button
            android:id="@+id/btnTestProfile"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1.2"
            android:text="Test Profile"
            android:textSize="11sp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btnTestTables"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1.1"
            android:text="Test Tables"
            android:textSize="11sp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btnTestStorage"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1.1"
            android:text="Test Storage"
            android:textSize="11sp"
            android:insetTop="0dp"
            android:insetBottom="0dp" />
    </LinearLayout>

    <!-- Buttons Row 3: 7. Session, 8. Clear Session, 9. Copy Log -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="4dp">

        <Button
            android:id="@+id/btnSession"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:text="Session"
            android:textSize="11sp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btnClearSession"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1.2"
            android:text="Clear Session"
            android:textSize="10sp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btnCopyLog"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1.1"
            android:text="Copy Log"
            android:textSize="11sp"
            android:insetTop="0dp"
            android:insetBottom="0dp" />
    </LinearLayout>

    <!-- Quick Utilities Row: Run All & Clear Log -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="6dp">

        <Button
            android:id="@+id/btnRunAll"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1.5"
            android:text="Run All Diagnostics"
            android:textSize="11sp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btnClearLog"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="Clear Log"
            android:textSize="11sp"
            android:insetTop="0dp"
            android:insetBottom="0dp" />
    </LinearLayout>

    <!-- Log Console ScrollView -->
    <ScrollView
        android:id="@+id/scrollLog"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#1E1E1E"
        android:padding="8dp">

        <TextView
            android:id="@+id/tvLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:typeface="monospace"
            android:textSize="11sp"
            android:textColor="#E0E0E0"
            android:textIsSelectable="true"
            android:text="=== Health Bridge Diagnostics Ready ===\nTap any button above to test.\n" />
    </ScrollView>

</LinearLayout>

